<!DOCTYPE html>
<html lang="mr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Document Advanced Redactor</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <style>
        .canvas-container { position: relative; display: inline-block; }
        .redact-canvas { position: absolute; top: 0; left: 0; cursor: crosshair; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-6 flex flex-col items-center">

    <div class="bg-slate-800 p-6 rounded-xl shadow-xl border border-slate-700 w-full max-w-4xl text-center mb-6">
        <h1 class="text-2xl font-bold text-blue-400">🛡️ Hospital Document Visual Redactor</h1>
        <p class="text-xs text-slate-400 mt-1">Mouse ne drag karun sensitive data blackout kara. <b>Kontahi box kadhnyasathi direct tyavar click kara!</b></p>
        
        <div class="mt-4 flex flex-wrap justify-center items-center gap-4">
            <input type="file" id="pdfInput" accept=".pdf" class="text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-slate-700 file:text-blue-400 hover:file:bg-slate-600 cursor-pointer"/>
            
            <button id="clearBtn" class="bg-red-600 hover:bg-red-500 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 shadow-md hidden">
                🗑️ Clear All
            </button>
            <button id="downloadBtn" class="bg-green-600 hover:bg-green-500 text-white font-semibold py-2 px-6 rounded-lg transition duration-200 shadow-md hidden">
                📥 Modified PDF Download
            </button>
        </div>
        <div id="status" class="mt-2 text-sm text-yellow-400"></div>
    </div>

    <div id="pdfViewer" class="flex flex-col gap-8 items-center w-full"></div>

    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';

        let originalPdfBytes = null;
        let redactionsPerPage = {}; 
        let canvasRenderers = {}; 

        document.getElementById('pdfInput').addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const status = document.getElementById('status');
            const viewer = document.getElementById('pdfViewer');
            viewer.innerHTML = ''; 
            redactionsPerPage = {};
            canvasRenderers = {};

            status.innerText = "⏳ PDF Document Open hot aahe...";

            try {
                originalPdfBytes = await file.arrayBuffer();
                const pdfJsDoc = await pdfjsLib.getDocument({ data: originalPdfBytes }).promise;
                
                status.innerText = `📄 Total ${pdfJsDoc.numPages} Pages load zale. Chukicha box kadhnyasathi direct tyavar single click kara.`;
                
                document.getElementById('downloadBtn').classList.remove('hidden');
                document.getElementById('clearBtn').classList.remove('hidden');

                for (let pageNum = 1; pageNum <= pdfJsDoc.numPages; pageNum++) {
                    redactionsPerPage[pageNum] = [];
                    
                    const wrapper = document.createElement('div');
                    wrapper.className = 'canvas-container border-2 border-slate-700 bg-white shadow-lg rounded';

                    const pdfCanvas = document.createElement('canvas');
                    const drawCanvas = document.createElement('canvas');
                    drawCanvas.className = 'redact-canvas';

                    wrapper.appendChild(pdfCanvas);
                    wrapper.appendChild(drawCanvas);
                    viewer.appendChild(wrapper);

                    const jsPage = await pdfJsDoc.getPage(pageNum);
                    const viewport = jsPage.getViewport({ scale: 1.5 });

                    pdfCanvas.width = drawCanvas.width = viewport.width;
                    pdfCanvas.height = drawCanvas.height = viewport.height;

                    const ctx = pdfCanvas.getContext('2d');
                    const dCtx = drawCanvas.getContext('2d');
                    
                    canvasRenderers[pageNum] = dCtx;

                    await jsPage.render({ canvasContext: ctx, viewport: viewport }).promise;

                    let isDrawing = false;
                    let dragged = false;
                    let startX, startY;

                    drawCanvas.addEventListener('mousedown', (e) => {
                        isDrawing = true;
                        dragged = false;
                        const rect = drawCanvas.getBoundingClientRect();
                        startX = e.clientX - rect.left;
                        startY = e.clientY - rect.top;
                    });

                    drawCanvas.addEventListener('mousemove', (e) => {
                        if (!isDrawing) return;
                        dragged = true;
                        const rect = drawCanvas.getBoundingClientRect();
                        const currentX = e.clientX - rect.left;
                        const currentY = e.clientY - rect.top;

                        dCtx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);
                        
                        redactionsPerPage[pageNum].forEach(box => {
                            dCtx.fillStyle = 'black';
                            dCtx.fillRect(box.x, box.y, box.w, box.h);
                        });

                        dCtx.fillStyle = 'rgba(0, 0, 0, 0.6)';
                        dCtx.fillRect(startX, startY, currentX - startX, currentY - startY);
                    });

                    drawCanvas.addEventListener('mouseup', (e) => {
                        if (!isDrawing) return;
                        isDrawing = false;
                        
                        const rect = drawCanvas.getBoundingClientRect();
                        const endX = e.clientX - rect.left;
                        const endY = e.clientY - rect.top;

                        const boxX = Math.min(startX, endX);
                        const boxY = Math.min(startY, endY);
                        const boxW = Math.abs(endX - startX);
                        const boxH = Math.abs(endY - startY);

                        // Jar mouse drag kela asel tarch navin box save hoto
                        if (dragged && boxW > 6 && boxH > 6) {
                            redactionsPerPage[pageNum].push({ x: boxX, y: boxY, w: boxW, h: boxH, scale: 1.5 });
                            redrawPageCanvas(pageNum);
                        } else if (!dragged) {
                            // OPTION SOLVED: Single click selection check to delete box
                            const clickX = startX;
                            const clickY = startY;
                            const originalLength = redactionsPerPage[pageNum].length;

                            redactionsPerPage[pageNum] = redactionsPerPage[pageNum].filter(box => {
                                const matchX = clickX >= box.x && clickX <= (box.x + box.w);
                                const matchY = clickY >= box.y && clickY <= (box.y + box.h);
                                return !(matchX && matchY); 
                            });

                            if (redactionsPerPage[pageNum].length < originalLength) {
                                document.getElementById('status').innerText = "🎯 Select kelela blackout box remove kela!";
                                redrawPageCanvas(pageNum);
                            }
                        }
                    });
                }
            } catch (err) {
                console.error(err);
                status.innerText = "❌ PDF Parsing fail.";
            }
        });

        function redrawPageCanvas(pageNum) {
            const dCtx = canvasRenderers[pageNum];
            if (!dCtx) return;
            dCtx.clearRect(0, 0, dCtx.canvas.width, dCtx.canvas.height);
            redactionsPerPage[pageNum].forEach(box => {
                dCtx.fillStyle = 'black';
                dCtx.fillRect(box.x, box.y, box.w, box.h);
            });
        }

        document.getElementById('clearBtn').addEventListener('click', () => {
            if (confirm("Purn page che boxes delete karayche aahet ka?")) {
                Object.keys(redactionsPerPage).forEach(pageNum => {
                    redactionsPerPage[pageNum] = [];
                    redrawPageCanvas(pageNum);
                });
                document.getElementById('status').innerText = "🗑️ Workspace cleared!";
            }
        });

        document.getElementById('downloadBtn').addEventListener('click', async () => {
            const status = document.getElementById('status');
            status.innerText = "⏳ PDF processing suru aahe...";

            try {
                const pdfLibDoc = await PDFLib.PDFDocument.load(originalPdfBytes);
                const libPages = pdfLibDoc.getPages();

                for (let pageNum = 1; pageNum <= libPages.length; pageNum++) {
                    const libPage = libPages[pageNum - 1];
                    const { height: pageLibHeight } = libPage.getSize();
                    const boxes = redactionsPerPage[pageNum] || [];

                    boxes.forEach(box => {
                        const scaleFactor = box.scale;
                        const pdfX = box.x / scaleFactor;
                        const pdfY = pageLibHeight - ((box.y + box.h) / scaleFactor);
                        const pdfW = box.w / scaleFactor;
                        const pdfH = box.h / scaleFactor;

                        libPage.drawRectangle({
                            x: pdfX,
                            y: pdfY,
                            width: pdfW,
                            height: pdfH,
                            color: PDFLib.rgb(0, 0, 0)
                        });
                    });
                }

                const finalPdfBytes = await pdfLibDoc.save();
                const blob = new Blob([finalPdfBytes], { type: "application/pdf" });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = "Final_Redacted_Report.pdf";
                link.click();
                status.innerText = "✅ File successfully download zali!";
            } catch (err) {
                console.error(err);
                status.innerText = "❌ Download link generation fail.";
            }
        });
    </script>
</body>
</html>
